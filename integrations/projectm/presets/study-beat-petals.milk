[preset00]
// Original MIT visual-study preset. Filled petals pulse around a dark center.
fDecay=0
warp=0
fWaveAlpha=0
shapecode_0_enabled=1
shapecode_0_sides=4
shapecode_0_additive=1
shapecode_0_num_inst=8
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.12
shapecode_0_r=1.0
shapecode_0_g=0.54
shapecode_0_b=0.27
shapecode_0_a=0.20
shapecode_0_r2=0.41
shapecode_0_g2=0.37
shapecode_0_b2=0.56
shapecode_0_a2=0.01
shapecode_0_border_r=0.78
shapecode_0_border_g=0.54
shapecode_0_border_b=0.35
shapecode_0_border_a=0.12
shape_0_per_frame1=ang=6.2831853*instance/8+0.12*sin(time*0.24);
shape_0_per_frame2=x=0.50+(0.115+0.018*bass_att)*cos(ang);
shape_0_per_frame3=y=0.37+(0.095+0.014*bass_att)*sin(ang);
shape_0_per_frame4=rad=0.115+0.018*bass_att;
shape_0_per_frame5=a=0.13+0.09*min(2,bass_att);
