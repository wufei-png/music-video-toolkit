[preset00]
// Original MIT visual-study preset. Four translucent filled shapes form warm light haze.
fDecay=0
warp=0
fWaveAlpha=0
shapecode_0_enabled=1
shapecode_0_sides=64
shapecode_0_additive=1
shapecode_0_num_inst=4
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.24
shapecode_0_r=1.0
shapecode_0_g=0.52
shapecode_0_b=0.23
shapecode_0_a=0.16
shapecode_0_r2=0.40
shapecode_0_g2=0.23
shapecode_0_b2=0.17
shapecode_0_a2=0
shapecode_0_border_a=0
shape_0_per_frame1=x=0.24+0.17*instance+0.025*sin(time*0.31+instance*1.7);
shape_0_per_frame2=y=0.27+0.075*instance+0.025*cos(time*0.23+instance*1.3);
shape_0_per_frame3=rad=0.22+0.055*bass_att+0.015*sin(time*0.4+instance);
shape_0_per_frame4=a=0.10+0.035*min(2,bass_att);
shapecode_1_enabled=1
shapecode_1_sides=64
shapecode_1_additive=1
shapecode_1_num_inst=3
shapecode_1_x=0.5
shapecode_1_y=0.5
shapecode_1_rad=0.18
shapecode_1_r=0.31
shapecode_1_g=0.48
shapecode_1_b=0.65
shapecode_1_a=0.09
shapecode_1_r2=0.19
shapecode_1_g2=0.28
shapecode_1_b2=0.46
shapecode_1_a2=0
shapecode_1_border_a=0
shape_1_per_frame1=x=0.33+0.18*instance+0.02*cos(time*0.21+instance*2.1);
shape_1_per_frame2=y=0.26+0.08*instance+0.02*sin(time*0.33+instance*1.4);
shape_1_per_frame3=rad=0.17+0.025*mid_att;
