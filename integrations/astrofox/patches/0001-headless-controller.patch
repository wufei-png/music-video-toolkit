diff --git a/src/app/mvt-job.ts b/src/app/mvt-job.ts
new file mode 100644
index 0000000..62bae1b
--- /dev/null
+++ b/src/app/mvt-job.ts
@@ -0,0 +1,57 @@
+import { initApp } from '@/app/actions/app';
+import { loadProjectFromPayload } from '@/app/actions/project';
+import { analyzer, audioContext, player, renderBackend, renderer } from '@/app/global';
+import { loadAudioData } from '@/lib/utils/audio';
+
+async function waitForCanvas() {
+  for (let tries = 0; tries < 200; tries += 1) {
+    if ((renderBackend as unknown as { initialized: boolean }).initialized) {
+      await renderBackend.ensureRoot();
+      return;
+    }
+    await new Promise(resolve => setTimeout(resolve, 50));
+  }
+  throw new Error('Hidden renderer canvas did not become ready');
+}
+
+export async function runMvtJob() {
+  const bridge = window.__ASTROFOX_JOB__;
+  if (!bridge) return;
+  try {
+    const input = await bridge.getInput();
+    const storage = window.__ASTROFOX__?.storage;
+    if (!storage) throw new Error('Desktop storage bridge unavailable');
+    for (const plugin of input.plugins) {
+      storage.set(`astrofox:plugin:${plugin.manifest.name}`, JSON.stringify(plugin));
+    }
+    await storage.flush();
+    await initApp();
+    await loadProjectFromPayload(input.payload, 'MVT job', true);
+    const bytes = new Uint8Array(input.audio);
+    const data = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
+    const audio = await loadAudioData(data);
+    const expectedSamples = Math.round(
+      (input.request.source.duration_samples * audioContext.sampleRate) / 48000,
+    );
+    if (!audio.buffer || Math.abs(audio.buffer.length - expectedSamples) > 1) {
+      throw new Error(
+        `Decoded canonical audio duration differs from request: ${audio.buffer?.length} versus ${expectedSamples}`,
+      );
+    }
+    player.load(audio, 'canonical.wav');
+    audio.addNode(analyzer.analyzer);
+    const size = renderBackend.getSize();
+    if (
+      size.width !== input.request.profile.width ||
+      size.height !== input.request.profile.height
+    ) {
+      throw new Error('Loaded project canvas differs from request');
+    }
+    await waitForCanvas();
+    renderer.stop();
+    await renderer.renderFrame(0, 30);
+    bridge.ready();
+  } catch (error) {
+    bridge.fail(error instanceof Error ? error.stack || error.message : String(error));
+  }
+}
