+import { createHash } from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const UPSTREAM_COMMIT = '126403958e5644a6fbb91d6623626474dd199205';
+
+function sha256(bytes) {
+  return createHash('sha256').update(bytes).digest('hex');
+}
+
+function canonicalJson(value) {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value)
+      .sort()
+      .map(key => `${JSON.stringify(key)}:${canonicalJson(value[key])}`)
+      .join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function localPath(record, value) {
+  if (typeof value !== 'string' || /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(value)) {
+    throw new Error(`Remote or invalid path: ${value}`);
+  }
+  return path.resolve(path.dirname(record), value);
+}
+
+function checkedFile(record, ref) {
+  if (!ref || !/^[a-f0-9]{64}$/.test(ref.sha256)) throw new Error('Missing file hash');
+  const file = localPath(record, ref.path);
+  const bytes = fs.readFileSync(file);
+  if (sha256(bytes) !== ref.sha256) throw new Error(`Input hash mismatch: ${file}`);
+  return { file, bytes };
+}
+
+function mediaPath(projectFile, value) {
+  if (typeof value !== 'string' || !value) return null;
+  if (/^file:\/\//i.test(value)) return path.resolve(fileURLToPath(value));
+  return localPath(projectFile, value);
+}
+
+function validateProjectMedia(payload, projectFile, allowedAssets) {
+  const snapshot = payload.snapshot ?? payload.snapshotJson ?? payload.project?.snapshot ?? payload;
+  if (!snapshot || typeof snapshot !== 'object' || !Array.isArray(snapshot.scenes)) {
+    throw new Error('Project requires a JSON snapshot with scenes');
+  }
+  for (const scene of snapshot.scenes) {
+    for (const element of [...(scene.displays ?? []), ...(scene.effects ?? [])]) {
+      const props = element.properties ?? {};
+      for (const field of ['src', 'sourcePath']) {
+        const value = props[field];
+        if (!value || typeof value !== 'string') continue;
+        if (/^https?:|^\/\//i.test(value)) throw new Error(`Remote media forbidden: ${value}`);
+      }
+      if (element.plugin?.url && /^(?:https?:|\/\/)/i.test(element.plugin.url)) {
+        throw new Error(`Remote plugin forbidden: ${element.plugin.url}`);
+      }
+      const source =
+        props.sourcePath ||
+        (typeof props.src === 'string' && !/^(?:data:|blob:|astrofox:)/i.test(props.src)
+          ? props.src
+          : '');
+      if (source) {
+        const resolved = mediaPath(projectFile, source);
+        if (!allowedAssets.has(resolved)) throw new Error(`Unlisted project asset: ${resolved}`);
+        if (element.name === 'ImageDisplay') {
+          const bytes = fs.readFileSync(resolved);
+          const ext = path.extname(resolved).toLowerCase();
+          const mime =
+            ext === '.png' ? 'image/png' : ext === '.jpg' || ext === '.jpeg' ? 'image/jpeg' : null;
+          if (!mime) throw new Error(`Unsupported local image: ${resolved}`);
+          props.src = `data:${mime};base64,${bytes.toString('base64')}`;
+          props.sourcePath = '';
+        } else if (element.name === 'VideoDisplay') {
+          props.sourcePath = resolved;
+        }
+      }
+    }
+  }
+  return payload;
+}
+
+function checkedPlugin(record, ref) {
+  const { file, bytes } = checkedFile(record, ref);
+  const plugin = JSON.parse(bytes.toString('utf8'));
+  if (plugin.dev || !plugin.manifest?.name || !Array.isArray(plugin.manifest.permissions)) {
+    throw new Error(`Invalid pinned plugin: ${file}`);
+  }
+  if (plugin.manifest.permissions.includes('network')) throw new Error('Network plugin forbidden');
+  if (!plugin.sourceUrl?.startsWith('file://')) {
+    throw new Error('Plugin source URL must be local');
+  }
+  const files = plugin.files ?? {};
+  const integrity = plugin.integrity ?? {};
+  if (
+    !Object.keys(files).length ||
+    Object.keys(files).sort().join() !== Object.keys(integrity).sort().join()
+  ) {
+    throw new Error(`Plugin files lack integrity: ${file}`);
+  }
+  for (const [name, content] of Object.entries(files)) {
+    const actual = `sha384-${createHash('sha384').update(content, 'utf8').digest('base64')}`;
+    if (actual !== integrity[name]) throw new Error(`Plugin content hash mismatch: ${name}`);
+  }
+  return plugin;
+}
+
+export function readMvtJob(requestPath) {
+  const requestFile = path.resolve(requestPath);
+  const requestBytes = fs.readFileSync(requestFile);
+  const request = JSON.parse(requestBytes.toString('utf8'));
+  if (
+    request.schema_version !== '0.1' ||
+    request.backend?.name !== 'astrofox' ||
+    request.backend?.commit !== UPSTREAM_COMMIT
+  ) {
+    throw new Error('Unsupported provider request or Astrofox revision');
+  }
+  if (
+    request.profile?.fps_num !== 30 ||
+    request.profile?.fps_den !== 1 ||
+    ![
+      [1920, 1080],
+      [1080, 1920],
+    ].some(([w, h]) => w === request.profile.width && h === request.profile.height)
+  ) {
+    throw new Error('Unsupported output profile');
+  }
+  const { start_sample: start, end_sample: end } = request.range ?? {};
+  if (
+    !Number.isSafeInteger(start) ||
+    !Number.isSafeInteger(end) ||
+    start < 0 ||
+    end <= start ||
+    end > request.source?.duration_samples ||
+    start % 1600 ||
+    end % 1600
+  ) {
+    throw new Error('Invalid global frame range');
+  }
+  if (sha256(Buffer.from(canonicalJson(request.parameters ?? {}))) !== request.parameters_sha256) {
+    throw new Error('Parameter hash mismatch');
+  }
+  const audio = checkedFile(requestFile, request.canonical_audio);
+  if (
+    request.source?.sha256 !== request.canonical_audio.sha256 ||
+    localPath(requestFile, request.source.path) !== audio.file
+  ) {
+    throw new Error('Canonical source identity mismatch');
+  }
+  const project = checkedFile(requestFile, request.project);
+  const assets = (request.assets ?? []).map(ref => checkedFile(requestFile, ref).file);
+  if (new Set(assets).size !== assets.length) throw new Error('Duplicate asset paths');
+  const plugins = (request.plugins ?? []).map(ref => checkedPlugin(requestFile, ref));
+  if (new Set(plugins.map(item => item.manifest.name)).size !== plugins.length) {
+    throw new Error('Duplicate plugin names');
+  }
+  const payload = validateProjectMedia(
+    JSON.parse(project.bytes.toString('utf8')),
+    project.file,
+    new Set(assets),
+  );
+  const snapshot = payload.snapshot ?? payload.snapshotJson ?? payload.project?.snapshot ?? payload;
+  if (
+    snapshot.stage?.properties?.width !== request.profile.width ||
+    snapshot.stage?.properties?.height !== request.profile.height
+  ) {
+    throw new Error('Project canvas differs from requested profile');
+  }
+  const available = new Set(plugins.map(item => item.manifest.name));
+  for (const scene of snapshot.scenes) {
+    for (const item of [...(scene.displays ?? []), ...(scene.effects ?? [])]) {
+      if (typeof item.name === 'string' && item.name.startsWith('@') && !available.has(item.name)) {
+        throw new Error(`Project plugin not pinned: ${item.name}`);
+      }
+    }
+  }
+  return {
+    request,
+    requestFile,
+    requestSha256: sha256(requestBytes),
+    payload,
+    audio: new Uint8Array(audio.bytes),
+    plugins,
+    allowedAssets: new Set(assets),
+  };
+}
