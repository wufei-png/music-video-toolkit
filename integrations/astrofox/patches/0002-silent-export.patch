diff --git a/scripts/astrofox-render.mjs b/scripts/astrofox-render.mjs
new file mode 100644
index 0000000..baf03f5
--- /dev/null
+++ b/scripts/astrofox-render.mjs
@@ -0,0 +1,114 @@
+#!/usr/bin/env node
+import { spawn, spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function fail(code, message) {
+  process.stdout.write(`${JSON.stringify({ status: 'failed', code, message })}\n`);
+  process.exitCode = 5;
+}
+
+function executable(name) {
+  const found = (process.env.PATH ?? '')
+    .split(path.delimiter)
+    .map(directory => path.join(directory, name))
+    .find(candidate => fs.existsSync(candidate) && fs.statSync(candidate).isFile());
+  if (!found) throw new Error(`${name} is not on PATH`);
+  return found;
+}
+
+function gitOutput(args) {
+  const result = spawnSync('git', args, { cwd: root, encoding: null });
+  if (result.error || result.status !== 0)
+    throw new Error(`git verification failed: ${result.stderr}`);
+  return result.stdout;
+}
+
+function verify(requestFile) {
+  const lock = JSON.parse(fs.readFileSync(path.join(root, '.git/mvt-lock.json'), 'utf8'));
+  const request = JSON.parse(fs.readFileSync(requestFile, 'utf8'));
+  const commit = gitOutput(['rev-parse', 'HEAD']).toString().trim();
+  const diffHash = createHash('sha256')
+    .update(gitOutput(['diff', '--binary', 'HEAD']))
+    .digest('hex');
+  if (
+    commit !== lock.commit ||
+    diffHash !== lock.applied_diff_sha256 ||
+    request.backend?.commit !== commit ||
+    request.backend?.integration_patch_sha256 !== lock.patch_stack_sha256 ||
+    request.backend?.version !==
+      JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8')).version
+  ) {
+    throw new Error('Request does not match the pinned Astrofox source and patch stack');
+  }
+}
+
+async function main() {
+  const args = process.argv.slice(2);
+  const requestIndex = args.indexOf('--request');
+  const outputIndex = args.indexOf('--output');
+  if (requestIndex < 0 || !args[requestIndex + 1] || outputIndex < 0 || !args[outputIndex + 1]) {
+    fail('invalid_arguments', 'Usage: astrofox-render --request FILE --output DIR');
+    return;
+  }
+  const request = path.resolve(args[requestIndex + 1]);
+  const output = path.resolve(args[outputIndex + 1]);
+  let ffmpeg;
+  let ffprobe;
+  try {
+    verify(request);
+    ffmpeg = executable('ffmpeg');
+    ffprobe = executable('ffprobe');
+  } catch (error) {
+    fail('preflight_failed', String(error));
+    return;
+  }
+  const electron = path.join(root, 'node_modules/.bin/electron');
+  const child = spawn(
+    electron,
+    [path.join(root, 'electron/main.mjs'), '--mvt-job', request, '--mvt-output', output],
+    {
+      cwd: root,
+      env: { ...process.env, ASTROFOX_JOB_FFMPEG: ffmpeg, ASTROFOX_JOB_FFPROBE: ffprobe },
+      stdio: ['ignore', 'pipe', 'inherit'],
+    },
+  );
+  let stdout = '';
+  child.stdout.setEncoding('utf8');
+  child.stdout.on('data', chunk => {
+    stdout += chunk;
+    if (stdout.length > 1024 * 1024) stdout = stdout.slice(-1024 * 1024);
+  });
+  let cancellation = false;
+  for (const signal of ['SIGINT', 'SIGTERM']) {
+    process.on(signal, () => {
+      cancellation = true;
+      child.kill(signal);
+    });
+  }
+  const code = await new Promise(resolve => {
+    child.on('error', () => resolve(5));
+    child.on('close', exitCode => resolve(exitCode ?? 5));
+  });
+  const lines = stdout.trim().split('\n').filter(Boolean);
+  let report;
+  try {
+    if (lines.length !== 1) throw new Error('Electron did not return one result');
+    report = JSON.parse(lines[0]);
+    if (!['completed', 'failed'].includes(report.status)) throw new Error('Invalid status');
+  } catch {
+    report = {
+      status: 'failed',
+      code: cancellation ? 'cancelled' : 'electron_failed',
+      message: `Electron exit ${code}`,
+    };
+  }
+  process.stdout.write(`${JSON.stringify(report)}\n`);
+  process.exitCode = report.status === 'completed' && code === 0 ? 0 : 5;
+}
+
+await main();
