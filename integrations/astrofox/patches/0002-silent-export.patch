diff --git a/electron/mvt-export.mjs b/electron/mvt-export.mjs
new file mode 100644
index 0000000..c232756
--- /dev/null
+++ b/electron/mvt-export.mjs
@@ -0,0 +1,158 @@
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+function fileSha256(file) {
+  return createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+}
+
+function toolOutput(tool, args) {
+  const result = spawnSync(tool, args, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
+  if (result.error || result.status !== 0) {
+    throw new Error(`${path.basename(tool)} failed: ${result.error?.message ?? result.stderr}`);
+  }
+  return result.stdout;
+}
+
+function rational(value) {
+  const [numerator, denominator] = value.split('/').map(Number);
+  if (!Number.isSafeInteger(numerator) || !Number.isSafeInteger(denominator) || denominator < 1) {
+    throw new Error(`Invalid media rate: ${value}`);
+  }
+  return [numerator, denominator];
+}
+
+export function prepareMvtOutput(directory) {
+  if (!directory) throw new Error('--mvt-output requires a destination');
+  const output = path.resolve(directory);
+  if (fs.existsSync(output)) throw new Error(`Output already exists: ${output}`);
+  const parent = path.dirname(output);
+  if (!fs.statSync(parent).isDirectory()) throw new Error(`Output parent missing: ${parent}`);
+  const temporary = fs.mkdtempSync(path.join(parent, `.${path.basename(output)}.tmp-`));
+  return { output, temporary, video: path.join(temporary, 'video.mp4') };
+}
+
+export function discardMvtOutput(job) {
+  if (job?.temporary) fs.rmSync(job.temporary, { recursive: true, force: true });
+}
+
+export function probeMvtOutput(videoFile, request, ffprobe) {
+  const result = JSON.parse(
+    toolOutput(ffprobe, [
+      '-v',
+      'error',
+      '-count_frames',
+      '-show_entries',
+      'stream=codec_type,codec_name,pix_fmt,width,height,r_frame_rate,avg_frame_rate,nb_read_frames,time_base',
+      '-of',
+      'json',
+      videoFile,
+    ]),
+  );
+  if (result.streams?.length !== 1 || result.streams[0].codec_type !== 'video') {
+    throw new Error('Provider result requires exactly one silent video stream');
+  }
+  const stream = result.streams[0];
+  const [fpsNum, fpsDen] = rational(stream.r_frame_rate);
+  const [avgNum, avgDen] = rational(stream.avg_frame_rate);
+  const frameCount = Number(stream.nb_read_frames);
+  const expectedFrames =
+    ((request.range.end_sample - request.range.start_sample) * request.profile.fps_num) /
+    (48000 * request.profile.fps_den);
+  if (
+    stream.codec_name !== 'h264' ||
+    stream.pix_fmt !== 'yuv420p' ||
+    stream.width !== request.profile.width ||
+    stream.height !== request.profile.height ||
+    fpsNum * request.profile.fps_den !== request.profile.fps_num * fpsDen ||
+    avgNum * request.profile.fps_den !== request.profile.fps_num * avgDen ||
+    !Number.isSafeInteger(expectedFrames) ||
+    frameCount !== expectedFrames
+  ) {
+    throw new Error(`Provider video clock/profile mismatch: ${JSON.stringify(stream)}`);
+  }
+  const [timeNum, timeDen] = rational(stream.time_base);
+  const frames = JSON.parse(
+    toolOutput(ffprobe, [
+      '-v',
+      'error',
+      '-select_streams',
+      'v:0',
+      '-show_frames',
+      '-show_entries',
+      'frame=best_effort_timestamp',
+      '-of',
+      'json',
+      videoFile,
+    ]),
+  ).frames;
+  if (
+    frames.length !== frameCount ||
+    frames.some((frame, index) => {
+      const actual = (Number(frame.best_effort_timestamp) * timeNum) / timeDen;
+      const expected = (index * request.profile.fps_den) / request.profile.fps_num;
+      return !Number.isFinite(actual) || Math.abs(actual - expected) > timeNum / timeDen;
+    })
+  ) {
+    throw new Error('Provider video timestamps are not exact CFR from local time zero');
+  }
+  return {
+    video_codec: 'h264',
+    pixel_format: 'yuv420p',
+    width: stream.width,
+    height: stream.height,
+    fps_num: request.profile.fps_num,
+    fps_den: request.profile.fps_den,
+    avg_fps_num: request.profile.fps_num,
+    avg_fps_den: request.profile.fps_den,
+    frame_count: frameCount,
+    has_audio: false,
+  };
+}
+
+export function installMvtOutput(job, input, ffmpeg, ffprobe) {
+  if (!fs.statSync(job.video).isFile()) throw new Error('Export did not write video.mp4');
+  const probe = probeMvtOutput(job.video, input.request, ffprobe);
+  const manifest = {
+    schema_version: '0.1',
+    status: 'completed',
+    request: {
+      path: path.relative(job.temporary, input.requestFile),
+      sha256: input.requestSha256,
+    },
+    source_sha256: input.request.source.sha256,
+    profile: input.request.profile,
+    range: input.request.range,
+    backend: input.request.backend,
+    project_sha256: input.request.project.sha256,
+    plugin_sha256: (input.request.plugins ?? []).map(ref => ref.sha256),
+    asset_sha256: (input.request.assets ?? []).map(ref => ref.sha256),
+    parameters_sha256: input.request.parameters_sha256,
+    environment: {
+      platform: process.platform,
+      arch: process.arch,
+      node: process.versions.node,
+      electron: process.versions.electron,
+      chromium: process.versions.chrome,
+      ffmpeg: toolOutput(ffmpeg, ['-version']).split('\n')[0],
+      ffmpeg_sha256: fileSha256(ffmpeg),
+      ffprobe: toolOutput(ffprobe, ['-version']).split('\n')[0],
+    },
+    video: { path: 'video.mp4', sha256: fileSha256(job.video) },
+    probe,
+  };
+  fs.writeFileSync(
+    path.join(job.temporary, 'provider-manifest.json'),
+    `${JSON.stringify(manifest, null, 2)}\n`,
+    { flag: 'wx' },
+  );
+  if (fs.existsSync(job.output)) throw new Error(`Output appeared during render: ${job.output}`);
+  fs.renameSync(job.temporary, job.output);
+  return {
+    status: 'completed',
+    manifest: path.join(job.output, 'provider-manifest.json'),
+    video: path.join(job.output, 'video.mp4'),
+    video_sha256: manifest.video.sha256,
+  };
+}
