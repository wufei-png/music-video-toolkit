{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "enum": [
            "image",
            "video",
            "font"
          ],
          "title": "Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "origin": {
          "enum": [
            "user",
            "harness",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "source_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Note"
        }
      },
      "required": [
        "id",
        "path",
        "type",
        "sha256",
        "origin"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "assets"
  ],
  "title": "AssetManifest",
  "type": "object"
}
