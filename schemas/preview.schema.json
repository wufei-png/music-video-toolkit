{
  "$defs": {
    "PreviewRange": {
      "additionalProperties": false,
      "properties": {
        "start_sample": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "end_sample": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End Sample",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "default": "other",
          "enum": [
            "sparse",
            "climax",
            "transition",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "start_sample",
        "end_sample",
        "id"
      ],
      "title": "PreviewRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "ranges": {
      "items": {
        "$ref": "#/$defs/PreviewRange"
      },
      "minItems": 1,
      "title": "Ranges",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "ranges"
  ],
  "title": "PreviewRequest",
  "type": "object"
}
