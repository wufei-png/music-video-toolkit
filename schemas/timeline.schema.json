{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Name",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Source",
          "type": "string"
        },
        "sample": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sample",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "name",
        "source",
        "sample"
      ],
      "title": "Event",
      "type": "object"
    },
    "JsonValue": {},
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "start_sample": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "end_sample": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End Sample",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "origin": {
          "enum": [
            "automatic",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "start_sample",
        "end_sample",
        "id",
        "origin"
      ],
      "title": "Section",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "start_sample": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "hop_samples": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Hop Samples",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "hop_samples",
        "values",
        "unit"
      ],
      "title": "Signal",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sample_rate": {
          "maximum": 48000,
          "minimum": 48000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "duration_samples": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Duration Samples",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "sample_rate",
        "duration_samples"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "analysis": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Analysis",
      "type": "array"
    },
    "signals": {
      "patternProperties": {
        "^[a-zA-Z0-9_.-]+$": {
          "$ref": "#/$defs/Signal"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Signals",
      "type": "object"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source",
    "analysis"
  ],
  "title": "Timeline",
  "type": "object"
}
