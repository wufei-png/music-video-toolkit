{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "SampleRange": {
      "additionalProperties": false,
      "properties": {
        "start_sample": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "end_sample": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End Sample",
          "type": "integer"
        }
      },
      "required": [
        "start_sample",
        "end_sample"
      ],
      "title": "SampleRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "cache_key": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "inputs": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_.-]+$": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Inputs",
      "type": "object"
    },
    "seed": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "environment": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_.-]+$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Environment",
      "type": "object"
    },
    "ranges": {
      "items": {
        "$ref": "#/$defs/SampleRange"
      },
      "minItems": 1,
      "title": "Ranges",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "schema_version",
    "cache_key",
    "status",
    "source_sha256",
    "inputs",
    "seed",
    "environment",
    "ranges"
  ],
  "title": "RenderManifest",
  "type": "object"
}
